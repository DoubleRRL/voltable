# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# build output and generated assets
/dist/
/data/
# The hand-filed failure set IS source: 16 hand-verified rows that the eval
# gates are calibrated against. Generated eval artifacts (perturbed rows,
# reports, the sqlite index) stay out.
!/data/eval/real.jsonl
/public/icons/
/public/images/
/public/favicon*.ico
/public/apple-touch-icon.png

# production
/build
/data/*.sqlite
/data/*.sqlite-*
/data/**/*.png
# Evidence images are generated by ingest from the manuals, one manual per
# subdirectory, and are the largest thing in the bundle. See docs/evidence.md.
/public/evidence/
# Render/OCR work files (git object store from a tool, not source).
/blobs/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
