{
  "name": "esr-rag",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "22.16.0"
  },
  "scripts": {
    "parse:manuals": "bash scripts/render/parse-manuals.sh",
    "ingest:manuals": "tsx scripts/ingest-manuals.ts",
    "ingest:manuals:force": "tsx scripts/ingest-manuals.ts --force-render",
    "build:eval": "tsx scripts/build-eval-set.ts",
    "eval:manuals": "tsx scripts/eval-esr.ts",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "build:evidence": ".venv-mineru/bin/python scripts/render/evidence.py build",
    "plan:evidence": ".venv-mineru/bin/python scripts/render/evidence.py plan",
    "audit:citations": ".venv-mineru/bin/python scripts/audit-citations.py",
    "audit:visuals": ".venv-mineru/bin/python scripts/audit-visuals.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.2.4",
    "p-limit": "^7.3.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-isokit": "^0.4.0",
    "shadcn": "^4.21.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "registries": {
    "@fluid": "https://www.fluidfunctionalism.com/r/{name}.json"
  }
